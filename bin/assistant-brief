#!/usr/bin/env bash
#
# assistant-brief — headless /triage in the assistant home, then a ping.
# Run by launchd: launchd/com.sjsimpson.assistant-{brief,winddown}.plist.
#
#   assistant-brief [brief]      morning brief (08:30 daily)
#   assistant-brief winddown     end of day (16:45 Mon-Fri)
#   assistant-brief prep         1:1 prep + project update drafts →
#                                weekly/YYYY-Www.md
#   --force      run even if already done   --dry   print command only
#   --scheduled  launchd only: skip winddown outside 16:00-22:00, so a run
#                missed while asleep doesn't fire the next morning
#
# Prep rides along: Thursday's wind-down adds it; Friday's brief adds it if
# Thursday's was missed. Manual runs work any time (e.g. `assistant-brief
# winddown` to wrap up early; the 16:45 run then skips). Weekends: brief is
# personal-only; no wind-down.
#
# Headless and read-only: tools not allowed below are denied; writes only to
# briefs/ and weekly/. Ping = ntfy push to $ASSISTANT_NTFY_TOPIC (~/env.zsh) +
# macOS notification. Counts only. Model: $ASSISTANT_MODEL (default sonnet).
# Log: ~/Library/Logs/assistant-brief.log

set -euo pipefail

export PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.dotfiles/bin"
home="${ASSISTANT_HOME:-$HOME/notes/assistant}"
today=$(date +%F)
week=$(date +%G-W%V)
dow=$(date +%u)
brief="$home/briefs/$today.md"
weekly="$home/weekly/$week.md"
log="$HOME/Library/Logs/assistant-brief.log"
model="${ASSISTANT_MODEL:-sonnet}"

kind=brief force=0 dry=0 scheduled=0
for arg in "$@"; do
  case "$arg" in
  brief | winddown | prep) kind=$arg ;;
  --force) force=1 ;;
  --dry) dry=1 ;;
  --scheduled) scheduled=1 ;;
  *)
    echo "unknown arg: $arg" >&2
    exit 1
    ;;
  esac
done

# launchd has no terminal: log everything
[[ -t 1 ]] || exec >>"$log" 2>&1
echo "== $(date '+%F %T') $kind"

if [[ $kind == winddown ]] && ((dow >= 6)); then
  echo "skip: no wind-down on weekends"
  exit 0
fi
if [[ $kind == winddown ]] && ((scheduled)); then
  hour=$((10#$(date +%H)))
  if ((hour < 16 || hour >= 22)); then
    echo "skip: winddown outside 16:00-22:00 (missed while asleep)"
    exit 0
  fi
fi

done_already() {
  case "$1" in
  brief) [[ -f "$brief" ]] ;;
  winddown) grep -qE '^## [0-9:]+ wind-down' "$brief" 2>/dev/null ;;
  prep) [[ -f "$weekly" ]] ;;
  esac
}

# prep rides along on Thu wind-down, or Fri brief if Thursday's was missed
with_prep=0
if [[ $kind == winddown ]] && ((dow == 4)); then with_prep=1; fi
if [[ $kind == brief ]] && ((dow == 5)); then with_prep=1; fi

allowed=(
  Skill Read Glob Grep
  "Write(./briefs/**)" "Edit(./briefs/**)"
  "Write(./weekly/**)" "Edit(./weekly/**)"
  "Bash(gh search prs:*)" "Bash(gh pr view:*)" "Bash(gh pr list:*)"
  "Bash(herdr api snapshot:*)" "Bash(obsidian tasks:*)"
  "Bash(grep -rn:*)" "Bash(date:*)" "Bash(ls:*)"
  mcp__claude_ai_Linear__get_notifications mcp__claude_ai_Linear__list_issues
  mcp__claude_ai_Linear__get_issue
  mcp__claude_ai_Linear__list_projects mcp__claude_ai_Linear__get_project
  mcp__claude_ai_Linear__get_status_updates
  mcp__claude_ai_Google_Calendar__list_events
  mcp__claude_ai_Gmail__search_threads mcp__claude_ai_Gmail__get_thread
  mcp__claude_ai_Sentry__search_issues
  mcp__claude_ai_Granola__list_meetings
  # whole server: plugin/.mcp.json runs it --read-only (no write actions)
  mcp__plugin_sjsimpson_basecamp
)
# belt and braces: dontAsk already denies anything not allowed
denied=(
  mcp__claude_ai_Gmail__send_message mcp__claude_ai_Gmail__reply
  mcp__claude_ai_Gmail__forward mcp__claude_ai_Gmail__create_draft
  mcp__claude_ai_Gmail__trash_thread mcp__claude_ai_Gmail__trash_message
  mcp__claude_ai_Gmail__label_thread mcp__claude_ai_Gmail__label_message
  mcp__claude_ai_Gmail__update_message_labels
  mcp__claude_ai_Linear__save_issue mcp__claude_ai_Linear__save_comment
  mcp__claude_ai_Linear__save_status_update mcp__claude_ai_Linear__save_project
  mcp__claude_ai_Linear__mark_notification
  mcp__claude_ai_Sentry__update_issue
  "Edit(./snoozed.md)" "Write(./snoozed.md)"
  "Edit(./priorities.md)" "Write(./priorities.md)"
)

notify() {
  terminal-notifier -title Assistant -message "$1" -open "$2" >/dev/null 2>&1 || true
  # phone push via ntfy; topic lives in ~/env.zsh, never in this repo.
  # Payload is the count line + link only: nothing sensitive leaves the Mac.
  local topic
  topic=$(zsh -c 'source ~/env.zsh 2>/dev/null; print -r -- "${ASSISTANT_NTFY_TOPIC:-}"')
  if [[ -z "$topic" ]]; then
    echo "no ASSISTANT_NTFY_TOPIC in ~/env.zsh; skipped phone push"
    return 0
  fi
  curl -fsS -o /dev/null -H "Title: Assistant" -H "Click: $2" -d "$1" \
    "${ASSISTANT_NTFY_SERVER:-https://ntfy.sh}/$topic" || echo "ntfy failed"
}

need_main=1 need_prep=$with_prep
if ((!force && !dry)); then
  done_already "$kind" && need_main=0
  ((with_prep)) && done_already prep && need_prep=0
fi
if ((!need_main && !need_prep)); then
  echo "skip: $kind already done"
  exit 0
fi
[[ $kind == prep ]] && need_prep=0 # prep is the main run

case "$kind" in
brief)
  file=$brief label="Brief ${today#*-}"
  if ((dow >= 6)); then
    mode=personal summary='SUMMARY: <n> due · <n> high'
  else
    mode=default summary='SUMMARY: <n> Now · <n> Today'
  fi
  ;;
winddown)
  file=$brief label="Wind-down ${today#*-}"
  mode=winddown summary='SUMMARY: <n> shipped · <n> open'
  ;;
prep)
  file=$weekly label="1:1 prep W${week#*-W}"
  mode=prep summary='SUMMARY: <n> wins · <n> slipped'
  ;;
esac
# main already done but prep missing (e.g. manual wind-down earlier): prep only
if ((!need_main)); then
  file=$weekly label="1:1 prep W${week#*-W}" mode=prep need_prep=0
  summary='SUMMARY: <n> wins · <n> slipped'
fi
if ((need_prep)); then
  mode="$mode + prep"
  label="$label + 1:1 prep"
fi

prompt="Run the triage skill in $mode mode. Unattended run: don't touch
snoozed.md (no pruning); don't mention the run itself in the output. Bash: one plain command per call (no
pipes, &&, ;, redirects, or subshells; use gh's --jq and --json flags instead),
or it's denied. Your final line must be exactly: $summary"
cmd=(claude -p "$prompt" --model "$model" --permission-mode dontAsk
  --allowedTools "${allowed[@]}" --disallowedTools "${denied[@]}"
  --add-dir "$HOME/notes" --output-format json --no-session-persistence
  --max-budget-usd 5)

if ((dry)); then
  printf '%q ' "${cmd[@]}"
  echo
  exit 0
fi

cd "$home"
out=$("${cmd[@]}" </dev/null) || true
result=$(jq -r '.result // ""' <<<"$out" 2>/dev/null || true)
echo "cost: $(jq -r '.total_cost_usd // "?"' <<<"$out" 2>/dev/null)"
jq -r '.permission_denials[]? | "denied: \(.tool_name) \(.tool_input.command // .tool_input.file_path // "")"' <<<"$out" 2>/dev/null || true

if [[ -f "$file" ]] && { ((!need_prep)) || done_already prep; }; then
  counts=$(grep -o 'SUMMARY: .*' <<<"$result" | tail -1 | sed 's/^SUMMARY: //')
  msg="$label: ${counts:-ready}"
else
  msg="$label failed; see ~/Library/Logs/assistant-brief.log"
  echo "$result" | tail -20
fi
rel=${file#"$home"/}
url="obsidian://open?vault=notes&file=assistant%2F${rel//\//%2F}"
url=${url%.md}
echo "$msg"
notify "$msg" "$url"
