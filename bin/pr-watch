#!/usr/bin/env bash
#
# pr-watch <pr> [-R owner/repo] [--as author|reviewer] [--every SECS] [--max-hours H]
#
# Polls a PR (default every 120s, gh only, no tokens). Run it in the
# background: it exits on the first change, one line per event.
#   both:     merged/closed; comments, reviews, replies from other humans
#   author:   CI failed; CI passed on a draft based on the default branch
#             (own pushes restart CI tracking without exiting)
#   reviewer: new push; review re-requested from me
# Read-only.

set -euo pipefail

usage() { sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
pr="" repo="" as=author every=120 max_hours=72
while [[ $# -gt 0 ]]; do
  case $1 in
    -R) repo=$2; shift 2 ;;
    --as) as=$2; shift 2 ;;
    --every) every=$2; shift 2 ;;
    --max-hours) max_hours=$2; shift 2 ;;
    -h|--help) usage ;;
    *) pr=${1##*/pull/}; pr=${pr%%[/?#]*}; [[ $1 == */pull/* ]] && repo=${1#*github.com/} && repo=${repo%%/pull/*}; shift ;;
  esac
done
[[ -n "$pr" && ( $as == author || $as == reviewer ) ]] || usage
[[ -n "$repo" ]] || repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)
me=$(gh api user -q .login)

snap() {
  gh api graphql -F o="${repo%/*}" -F r="${repo#*/}" -F n="$pr" -f query='
query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){defaultBranchRef{name} pullRequest(number:$n){
  state headRefOid isDraft baseRefName
  reviewRequests(first:50){nodes{requestedReviewer{... on User{login}}}}
  comments(last:100){nodes{author{login __typename}}}
  reviews(last:100){nodes{author{login __typename} state}}
  reviewThreads(first:100){nodes{comments(last:50){nodes{author{login __typename}}}}}
  commits(last:1){nodes{commit{statusCheckRollup{contexts(first:100){nodes{
    __typename
    ... on CheckRun{name status conclusion}
    ... on StatusContext{context state}}}}}}}
}}}' | jq -c --arg me "$me" '
  .data.repository.pullRequest as $p
  | def human: .author != null and .author.__typename != "Bot" and .author.login != $me
      and (.author.login | endswith("[bot]") | not);
  ([$p.commits.nodes[0].commit.statusCheckRollup.contexts.nodes // [] | .[]]) as $ctx
  | {
      state: $p.state,
      head: $p.headRefOid,
      bottom_draft: ($p.isDraft and $p.baseRefName == .data.repository.defaultBranchRef.name),
      requested: ([$p.reviewRequests.nodes[].requestedReviewer.login] | index($me) != null),
      talk: (([$p.comments.nodes[] | select(human)] | length)
           + ([$p.reviews.nodes[] | select(human) | select(.state != "PENDING")] | length)
           + ([$p.reviewThreads.nodes[].comments.nodes[] | select(human)] | length)),
      checks: ($ctx | length),
      pending: ([$ctx[] | select((.status // "COMPLETED") != "COMPLETED" or .state == "PENDING" or .state == "EXPECTED")] | length),
      failing: [$ctx[] | select(.conclusion == "FAILURE" or .conclusion == "TIMED_OUT"
                 or .conclusion == "CANCELLED" or .conclusion == "ACTION_REQUIRED"
                 or .state == "FAILURE" or .state == "ERROR") | (.name // .context)]
    }'
}

prev=$(snap)
ci_open=$(jq -r '.checks == 0 or .pending > 0' <<<"$prev")
deadline=$(( $(date +%s) + max_hours * 3600 ))

while :; do
  sleep "$every"
  cur=$(snap 2>/dev/null) || continue
  events=()
  state=$(jq -r .state <<<"$cur")
  [[ $state != OPEN ]] && events+=("PR #$pr $state")
  pushed=$([[ $(jq -r .head <<<"$cur") != $(jq -r .head <<<"$prev") ]] && echo true || echo false)
  [[ $as == author && $pushed == true ]] && ci_open=true
  new_talk=$(( $(jq .talk <<<"$cur") - $(jq .talk <<<"$prev") ))
  (( new_talk > 0 )) && events+=("$new_talk new comment(s)/review(s) from others")
  if [[ $as == reviewer ]]; then
    [[ $pushed == true ]] && events+=("new push $(jq -r '.head[0:7]' <<<"$cur")")
    [[ $(jq .requested <<<"$cur") == true && $(jq .requested <<<"$prev") == false ]] &&
      events+=("re-review requested from $me")
  elif [[ $ci_open == true ]] && jq -e '.checks > 0 and .pending == 0' <<<"$cur" >/dev/null; then
    ci_open=false
    failing=$(jq -r '.failing | join(", ")' <<<"$cur")
    if [[ -n $failing ]]; then events+=("CI finished: FAILED: $failing")
    elif jq -e .bottom_draft <<<"$cur" >/dev/null; then events+=("CI finished: all passed (draft on the default branch)")
    fi
  fi
  if (( ${#events[@]} )); then
    printf 'pr-watch %s#%s (%s):\n' "$repo" "$pr" "$as"
    printf -- '- %s\n' "${events[@]}"
    exit 0
  fi
  if (( $(date +%s) > deadline )); then
    echo "pr-watch $repo#$pr: no change in ${max_hours}h, re-arm if still needed"
    exit 0
  fi
done
