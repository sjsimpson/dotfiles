#!/usr/bin/env bash
#
# qa-login <url> — log in by hand once; qa-tester's browsers reuse it.
#
# Opens Chrome on qa-tester's golden profile at <url>. Log in (any app; the
# profile holds every host), then close the window. Each worktree's profile
# is re-seeded from it on its next qa-tester run (see qa-browser).

set -euo pipefail

[[ $# -eq 1 ]] || {
  sed -n '3,7p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}
golden="${XDG_CACHE_HOME:-$HOME/.cache}/qa-tester/profile"
mkdir -p "$golden"

# closing the window or ^C can exit non-zero; the profile is saved either way
npx -y -p @playwright/mcp@latest playwright open \
  --channel chrome --user-data-dir="$golden" "$1" || true
touch "$golden/.login-stamp"
echo "saved: $golden"
