{
  "name": "dotfiles",
  "owner": {
    "name": "sjsimpson"
  },
  "description": "Third-party skills I use, pinned to just the parts I want",
  "plugins": [
    {
      "name": "gh-stack",
      "description": "Stacked PRs with the gh stack extension",
      "source": {
        "source": "github",
        "repo": "github/gh-stack"
      },
      "strict": false,
      "skills": [
        "./skills/"
      ]
    },
    {
      "name": "find-skills",
      "description": "Search for and install skills",
      "source": {
        "source": "github",
        "repo": "vercel-labs/skills"
      },
      "strict": false,
      "skills": [
        "./skills/find-skills"
      ]
    }
  ]
}
