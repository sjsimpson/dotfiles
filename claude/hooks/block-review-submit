#!/usr/bin/env bash
#
# PreToolUse(Bash) backstop: submitting a review or posting a public PR
# comment always prompts the user, even in auto mode, so it happens only when
# they asked for it. Pending-review writes go through `pr-pending` (never
# sends an event) and don't prompt.

cmd=$(jq -r '.tool_input.command // ""')

block() {
  jq -n --arg r "$1: public GitHub write, needs the user's OK. Pending-review comments go through pr-pending" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $r}}'
  exit 0
}

grep -qE 'submitPullRequestReview|addPullRequestReviewComment|addComment[^a-zA-Z]|dismissPullRequestReview' <<<"$cmd" &&
  block "GraphQL submit/comment mutation"
grep -qE '\bgh +pr +(review|comment)\b' <<<"$cmd" && block "gh pr review/comment"
grep -qE '/dismissals' <<<"$cmd" && block "review dismissal"

# REST writes to reviews or comment endpoints (reads are fine)
if grep -qE 'pulls/[^ ]+/(reviews|comments)|issues/[^ ]+/comments|pulls/comments/' <<<"$cmd" &&
  grep -qE '(^| )(-f|-F|--field|--raw-field|--input|-X|--method)( |=)' <<<"$cmd"; then
  grep -qE '(-X|--method)[ =]+(GET|get)\b' <<<"$cmd" || block "REST write to a PR review/comment endpoint"
fi
exit 0
