    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "focused=$(kitty @ ls 2>/dev/null | jq -r --argjson wid \"$KITTY_WINDOW_ID\" '[.[].tabs[].windows[] | select(.id == $wid) | .is_focused] | first // false'); if [ \"$focused\" != \"true\" ]; then jq -r '.message // \"Needs your attention\"' | { read -r msg; terminal-notifier -title \"Claude Code\" -message \"$msg\" -sound default; }; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/spencer/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
