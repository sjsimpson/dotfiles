[user]
    name = sjsimpson
    email = spencerjsimpson@gmail.com
[core]
    pager = delta
[init]
    defaultBranch = main
[push]
    autoSetupRemote = true
[branch]
    # only track the start point when names match: `worktree add -b foo origin/main`
    # (herdr's --base) leaves foo untracked; first push sets origin/foo
    autoSetupMerge = simple
[fetch]
    prune = true
[merge]
    conflictstyle = zdiff3
[rerere]
    enabled = true
[dotfiles]
    managed = true
[delta]
    navigate                      = true
    minus-style                   = syntax "#3f2d3d"
    minus-non-emph-style          = syntax "#3f2d3d"
    minus-emph-style              = syntax "#763842"
    minus-empty-line-marker-style = syntax "#3f2d3d"
    line-numbers-minus-style      = "#b2555b"
    plus-style                    = syntax "#283b4d"
    plus-non-emph-style           = syntax "#283b4d"
    plus-emph-style               = syntax "#316172"
    plus-empty-line-marker-style  = syntax "#283b4d"
    line-numbers-plus-style       = "#266d6a"
    line-numbers-zero-style       = "#3b4261"
[interactive]
    diffFilter = delta --color-only
[diff]
    colorMoved = default

# machine-specific overrides (work email, tool ids); last so it wins
[include]
    path = ~/.gitconfig.local
